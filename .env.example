APP_NAME=Ayat of The Day Twitter Bot
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Generate a long random value. AOD's TWITTER_BOT_TOKEN must match it.
SERVICE_BEARER_TOKEN=replace-with-a-long-random-token

# X browser-session cookies. Treat both as full-account credentials.
TWITTER_AUTH_TOKEN=replace-with-x-auth-token-cookie
TWITTER_CT0=replace-with-x-ct0-cookie
TWITTER_SEC_CH_UA_PLATFORM=Windows

